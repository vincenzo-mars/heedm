{
  "permissions": {
    "allow": [
      "Bash(source \"$HOME/.cargo/env\")",
      "Bash(source ~/.cargo/env)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run tauri dev)",
      "Bash(npx svelte-check *)",
      "Bash(npx biome check --staged --no-errors-on-unmatched)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo search *)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(pkill -f whisper-server)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs-updated.sh\"",
            "timeout": 10,
            "statusMessage": "Controllo regola docs..."
          }
        ]
      }
    ]
  }
}
